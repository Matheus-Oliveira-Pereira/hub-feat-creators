# ===========================================================================
# HUB Feat Creator — environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.
# ===========================================================================

# ---------------------------------------------------------------------------
# Backend (Spring Boot — apps/api)
# ---------------------------------------------------------------------------

# PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/hub_feat_creators
DATABASE_USERNAME=hub_app
DATABASE_PASSWORD=changeme

# Auth (JWT)
JWT_SECRET=replace-with-256-bit-random-secret
JWT_EXPIRATION_MINUTES=60

# Admin bootstrap (PRD-020) — cria OWNER no primeiro boot se não existir
# TROQUE antes de ir para produção
ADMIN_EMAIL=admin@hub.local
ADMIN_PASSWORD=changeme-set-in-prod
FEATURE_ADMIN_BOOTSTRAP_ENABLED=true

# CORS — origens permitidas (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (PRD-019) — conta SMTP única de sistema
# Chave AES-256 (32 bytes) para criptografar senha SMTP em repouso
# Gere com: openssl rand -base64 32 | head -c 32
EMAIL_KEY=dev-only-not-for-prod-32-byte-aes-key
# Fallback env vars — usados quando system_email_config (DB) está vazio
# OWNR também pode configurar via UI em Configurações > E-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sistema@suaempresa.com
SMTP_PASS=changeme-use-app-password-gmail
SMTP_FROM=sistema@suaempresa.com
SMTP_FROM_NAME=feat. creators
SMTP_TLS=STARTTLS
SMTP_QUOTA=500

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# WhatsApp (PRD-008) — Meta Cloud API
# Chave AES-256 (32 bytes) para criptografar tokens Meta em repouso (separada do EMAIL_KEY)
# Gere com: openssl rand -base64 32 | head -c 32
WHATSAPP_KEY=dev-only-not-for-prod-whatsapp-32b!
# Token de verificação do webhook Meta (GET /webhook?hub.verify_token=…)
# Gere com: openssl rand -hex 20
WHATSAPP_VERIFY_TOKEN=

# Social OAuth (PRD-015) — Redes sociais Instagram/YouTube/TikTok
# Chave AES-256 (32 bytes) para criptografar tokens OAuth de redes sociais em repouso
# Gere com: openssl rand -base64 32 | head -c 32
SOCIAL_KEY=dev-only-not-for-prod-social-32b!!!
# MFA TOTP (onboarding) — Chave AES-256 (32 bytes) para criptografar secrets TOTP em repouso
# Gere com: openssl rand -base64 32 | head -c 32
MFA_KEY=dev-only-not-for-prod-mfa-key-32bytes
# Instagram (Meta App)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8080/api/v1/social/auth/INSTAGRAM/callback
# Google / YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/api/v1/social/auth/YOUTUBE/callback
# TikTok Display API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8080/api/v1/social/auth/TIKTOK/callback
FEATURE_SOCIAL_ENABLED=false    # Habilita módulo social OAuth; false até app registrations aprovados

# Feature flags
# Web Push / VAPID (PRD-009) — gere um par de chaves com: npx web-push generate-vapid-keys
# Formato: Base64 URL-encoded (sem padding)
WEBPUSH_PUBLIC_KEY=replace-with-vapid-public-key
WEBPUSH_PRIVATE_KEY=replace-with-vapid-private-key
WEBPUSH_SUBJECT=mailto:ma.pe.oli.1998@gmail.com

# IA Match (PRD-016) — Python FastAPI ai-worker com sentence-transformers 384-dim
AI_WORKER_URL=http://localhost:8000   # URL do ai-worker; vazio desabilita embeddings (zero vector fallback)
FEATURE_AI_MATCH_ENABLED=false
FEATURE_WHATSAPP_ENABLED=false     # Habilita módulo WhatsApp; false até conta Meta aprovada
FEATURE_COMPLIANCE_STRICT=true   # LGPD: valida base legal obrigatória; false só em dev/testes
FEATURE_SIGNUP_ENABLED=true      # Habilita signup self-service; false congela novos tenants
FEATURE_PORTAL_ENABLED=false     # Habilita portal creator (PRD-013); false até build aprovado
FEATURE_MOBILE_ENABLED=false     # Habilita Expo push (FCM/APNs) via ExpoPushSender (PRD-014)
WEB_BASE_URL=http://localhost:3000  # URL do frontend (links em e-mails transacionais)

# ---------------------------------------------------------------------------
# Frontend (Next.js — apps/web)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Memory Layer (L4)
# ---------------------------------------------------------------------------

# pgvector (opcional — usar quando memória for compartilhada entre devs)
# PGVECTOR_PASSWORD=changeme

# Embeddings (opcional — só se sair do modelo local all-MiniLM-L6-v2)
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...

# ---------------------------------------------------------------------------
# Integrações sociais (Fase 3 — match IA)
# ---------------------------------------------------------------------------

# INSTAGRAM_GRAPH_TOKEN=
# YOUTUBE_DATA_API_KEY=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
