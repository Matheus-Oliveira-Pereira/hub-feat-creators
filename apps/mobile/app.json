{
  "expo": {
    "name": "feat. creators",
    "slug": "hub-feat-creators",
    "version": "1.0.0",
    "scheme": "featcreators",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hubfeatcreators.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Para capturar e enviar materiais de campanha.",
        "NSMicrophoneUsageDescription": "Para gravar vídeos de campanha.",
        "NSPhotoLibraryUsageDescription": "Para selecionar fotos e vídeos da galeria.",
        "NSFaceIDUsageDescription": "Para autenticar com Face ID ao abrir o app."
      },
      "associatedDomains": ["applinks:app.featcreators.com"]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141414"
      },
      "package": "com.hubfeatcreators.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.featcreators.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Para autenticar com Face ID ao abrir o app."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C2E000",
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Para capturar e enviar materiais de campanha.",
          "microphonePermission": "Para gravar vídeos de campanha."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para selecionar fotos e vídeos da galeria.",
          "cameraPermission": "Para capturar materiais de campanha."
        }
      ],
      "@sentry/react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "FILL_EAS_PROJECT_ID"
      },
      "router": {
        "origin": false
      }
    }
  }
}
